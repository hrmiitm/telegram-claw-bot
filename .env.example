# ============================================================
# Telegram Bot Configuration
# ============================================================
TELEGRAM_BOT_TOKEN=get-your-own-bot-token-from-botfather

# ============================================================
# LLM Provider Configuration
# Supports: openai, google_genai, anthropic, ollama, etc.
# Format for create_agent model string: "provider:model_name"
# Examples:
#   openai:gpt-4o
#   google_genai:gemini-2.5-flash
#   anthropic:claude-sonnet-4-6
#   ollama:llama3
# ============================================================
MODEL_NAME=openai:gpt-5.4-mini

# ============================================================
# API Keys (set only the one you need)
# ============================================================
OPENAI_API_KEY=your-own-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================================
# Optional: Custom Base URL (for OpenAI-compatible endpoints)
# Uncomment if using a local/custom server like Ollama, LMStudio, vLLM
# ============================================================
OPENAI_API_BASE=base-url

# ============================================================
# File Storage
# ============================================================
DOWNLOAD_DIR=downloads
